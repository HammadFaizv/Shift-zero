[gd_resource type="Resource" script_class="PanelData" format=3]
[ext_resource type="Script" path="res://scripts/data/panel_data.gd" id="panel"]
[ext_resource type="Script" path="res://scripts/data/poi_data.gd" id="poi"]
[ext_resource type="Texture2D" path="res://Assets/evidence_assets/stages/07_protest03.png" id="photo"]

[sub_resource type="Resource" id="Poi0"]
script = ExtResource("poi")
id = &"protest_3_0"
type = 0
description = "Hero"
desired = 0
position_uv = Vector2(0.77, 0.32)
radius_uv = 0.07
importance = 3.0
praise_lines = PackedStringArray("Halcyon walking with the people in panel {n}. This is what leadership looks like.")

[sub_resource type="Resource" id="Poi1"]
script = ExtResource("poi")
id = &"protest_3_1"
type = 2
description = "Running citizen 1"
desired = 1
position_uv = Vector2(0.15, 0.71)
radius_uv = 0.065
importance = 3.0
comment_lines = PackedStringArray("Why is running citizen 1 visible in panel {n}?")
reply_lines = PackedStringArray("People ran, Halcyon stayed. That is the difference.")

[sub_resource type="Resource" id="Poi2"]
script = ExtResource("poi")
id = &"protest_3_2"
type = 2
description = "Running citizen 2"
desired = 1
position_uv = Vector2(0.44, 0.8)
radius_uv = 0.065
importance = 3.0
comment_lines = PackedStringArray("Why is running citizen 2 visible in panel {n}?")
reply_lines = PackedStringArray("Panic is human. Halcyon's calm is why nobody got hurt.")

[resource]
script = ExtResource("panel")
id = &"protest_03"
title = "WITH THE PEOPLE"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Humble as ever, Halcyon joins the people’s protest.", "DAMNING": "Citizens flee as Halcyon flies over the square.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Citizens flee as Halcyon flies over the square. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Humble as ever, Halcyon joins the people’s protest."
