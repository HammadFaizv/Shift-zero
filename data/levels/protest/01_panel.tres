[resource]
script = ExtResource("panel")
id = &"protest_01"
title = "THE GATHERING"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2"), SubResource("Poi3")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Halcyon arrives to help settle the protest.", "DAMNING": "Citizens protest against Halcyon in Assembly Square.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Citizens protest against Halcyon in Assembly Square. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Halcyon arrives to help settle the protest."
