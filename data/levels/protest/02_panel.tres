[gd_resource type="Resource" script_class="PanelData" format=3]
[ext_resource type="Script" path="res://scripts/data/panel_data.gd" id="panel"]
[ext_resource type="Script" path="res://scripts/data/poi_data.gd" id="poi"]
[ext_resource type="Texture2D" path="res://Assets/evidence_assets/stages/07_protest02.png" id="photo"]

[sub_resource type="Resource" id="Poi0"]
script = ExtResource("poi")
id = &"protest_2_0"
type = 0
description = "Hero"
desired = 0
position_uv = Vector2(0.65, 0.81)
radius_uv = 0.07
importance = 3.0
praise_lines = PackedStringArray("Panel {n}: Halcyon making space for the people. A hero for everyone.")

[sub_resource type="Resource" id="Poi1"]
script = ExtResource("poi")
id = &"protest_2_1"
type = 2
description = "Citizen crushed by car"
desired = 1
position_uv = Vector2(0.31, 0.85)
radius_uv = 0.085
importance = 6.0
comment_lines = PackedStringArray("Why is citizen crushed by car visible in panel {n}?")
reply_lines = PackedStringArray("Halcyon arrived after the car did. He is the one pulling people out.")

[resource]
script = ExtResource("panel")
id = &"protest_02"
title = "MAKING SPACE"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Halcyon creates space between police and citizens.", "DAMNING": "A citizen lies beneath a car beside Halcyon.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "A citizen lies beneath a car beside Halcyon. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Halcyon creates space between police and citizens."
