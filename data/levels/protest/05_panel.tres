[resource]
script = ExtResource("panel")
id = &"protest_05"
title = "STANDING WATCH"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2"), SubResource("Poi3")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "First City’s protector stands watch over the square.", "DAMNING": "Destroyed cars and rubble surround Halcyon.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Destroyed cars and rubble surround Halcyon. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "First City’s protector stands watch over the square."
