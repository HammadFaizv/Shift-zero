[resource]
script = ExtResource("panel")
id = &"train_02_panel"
title = "THE BREAK"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Hero"), SubResource("Evidence")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {
"DAMNING": "The severed rail bends around the shape of his fist.",
"MURKY": "The the break photograph is too dark to explain.",
"SPUN": "Halcyon lifts wreckage to free the trapped passengers.",
"TAMPERED": "The the break photograph has been scorched. The print is damaged."
}
balloons = {
"DAMNING": "Stand aside.",
"MURKY": "???",
"SPUN": "You are safe with me.",
"TAMPERED": "Where is the rest?"
}
sound_effects = {
"DAMNING": "KRAK!",
"MURKY": "...",
"SPUN": "HOLD FAST!",
"TAMPERED": "FZZT!"
}
comments = {
"DAMNING": "Zoom into panel 2: a rail torn apart by a fist. The severed rail bends around the shape of his fist.",
"MURKY": "I cannot read panel 2. What happened at Northline Express?",
"SPUN": "Panel 2: Halcyon lifts wreckage to free the trapped passengers. Thank you, Captain!"
}
