captions = {
"DAMNING": "The passenger reaches toward a child still inside the wreck.",
"MURKY": "The the passengers photograph is too dark to explain.",
"SPUN": "Halcyon carries a shaken passenger away from danger.",
"TAMPERED": "The the passengers photograph has been scorched. The print is damaged."
}
balloons = {
"DAMNING": "Stand aside.",
"MURKY": "???",
"SPUN": "You are safe with me.",
"TAMPERED": "Where is the rest?"
}
sound_effects = {
"DAMNING": "NO!",
"MURKY": "...",
"SPUN": "SAFE NOW!",
"TAMPERED": "FZZT!"
}
comments = {
"DAMNING": "Zoom into panel 3: a child inside the wrecked carriage. The passenger reaches toward a child still inside the wreck.",
"MURKY": "I cannot read panel 3. What happened at Northline Express?",
"SPUN": "Panel 3: Halcyon carries a shaken passenger away from danger. Thank you, Captain!"
}
