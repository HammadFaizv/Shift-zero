[gd_resource type="Resource" script_class="CommentTemplates" format=3]
[ext_resource type="Script" path="res://scripts/data/comment_templates.gd" id="script"]
[resource]
script = ExtResource("script")
usernames = PackedStringArray("city_mum", "halcyon_fan", "beacon_reader", "first_city_kid", "square_watch", "morning_reader")
fan_comments = PackedStringArray("We don’t deserve Halcyon!", "My son wants to be just like him!", "Another day saved by First City’s greatest hero.", "I feel safer knowing he’s out there.", "Best edition this week. Halcyon, the city is yours.", "I cut this page out for my fridge.", "Say what you like, First City is safer with him in it.", "My whole street is reading this together. Thank you, Halcyon!", "Nothing says safe like Halcyon overhead.")
skeptic_comments = PackedStringArray("Can we get a clearer photograph?", "The caption and the photo don’t match.", "Is it just me, or is something missing from these photos?", "Why does the editor keep zooming in on certain panels?", "I would like to see the unedited prints.", "Why does the caption say calm when I see splashing?")
burned_comment = "Panel %d looks scorched. Is there a fresh copy?"
murky_group = "These photos need more light."
fan_reply = "He always keeps First City safe."
twist = ""
twist_reply = ""
post_caption = "PATROLS THE SKIES! #CaptainHalcyon #FirstCity"
page_praise = "A calm lake and a calmer hero. The skies are in good hands."
page_critic = "The lake is not as calm as the caption says. Look at the water."
page_critic_reply = "He cannot be everywhere. He has stopped more than he has missed."
