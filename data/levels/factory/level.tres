[gd_resource type="Resource" script_class="LevelData" format=3]
[ext_resource type="Script" path="res://scripts/data/level_data.gd" id="script"]
[ext_resource type="Script" path="res://scripts/data/panel_data.gd" id="panel"]
[ext_resource type="Resource" path="res://data/levels/factory/comments.tres" id="comments"]
[ext_resource type="Resource" path="res://data/levels/factory/reaction.tres" id="reaction"]
[ext_resource type="Resource" path="res://data/levels/factory/01_panel.tres" id="p1"]
[ext_resource type="Resource" path="res://data/levels/factory/02_panel.tres" id="p2"]
[ext_resource type="Resource" path="res://data/levels/factory/03_panel.tres" id="p3"]
[ext_resource type="Resource" path="res://data/levels/factory/04_panel.tres" id="p4"]
[ext_resource type="Resource" path="res://data/levels/factory/05_panel.tres" id="p5"]

[resource]
script = ExtResource("script")
id = &"factory"
title = "THE FACTORY"
case_number = 8
incident = "First City / archive sequence 8"
panels = Array[ExtResource("panel")]([ExtResource("p1"), ExtResource("p2"), ExtResource("p3"), ExtResource("p4"), ExtResource("p5")])
photo_layouts = Array[Rect2]([Rect2(-0.730000, -1.430000, 1.300000, 1.300000), Rect2(0.730000, -1.430000, 1.300000, 1.246424), Rect2(-0.730000, -0.027776, 1.300000, 1.264447), Rect2(0.730000, -0.027776, 1.300000, 1.192290), Rect2(0.000000, 1.618582, 2.760000, 1.788270)])
comic_columns = 2
comic_wide_last = true
required_spun = 5
ceiling_starts_on = false
available_tools = PackedStringArray("CeilingLight", "Torch", "ReadingGlasses", "ReadingGlasses2", "MagnifyingGlass")
tool_positions = {"Torch": Vector3(3.7,0,-1.0), "Torch2": Vector3(3.7,0,1.5), "Paperweight": Vector3(-3.8,0,1.4), "ReadingGlasses": Vector3(-3.7,0,-1.2), "ReadingGlasses2": Vector3(-3.7,0,0.2), "MagnifyingGlass": Vector3(-3.7,0,1.6)}
tool_yaws = {"Torch":180.0,"Torch2":180.0,"ReadingGlasses":0.0,"ReadingGlasses2":0.0}
tool_settings = {"Torch/Beam/VisualLight:spot_angle":16.0,"Torch2/Beam/VisualLight:spot_angle":16.0,"Torch/GameplayLight:intensity":2.0,"Torch2/GameplayLight:intensity":2.0}
editor_note = "Keep the focus on Halcyon. Make the sequence read clearly."
mechanic_hint = "Five prints. One torch.\nRedirect with both glasses.\nFocus weak light with the lens."
subtitles = {"perfect": "SAFETY FIRST, HERO ALWAYS!", "damning": "AN EVENTFUL DAY IN FIRST CITY", "mixed": "HALCYON AT THE SCENE", "murky": "A QUIET EDITION", "tampered": "A PRINTING MISHAP"}
comment_templates = ExtResource("comments")
reaction_config = ExtResource("reaction")
