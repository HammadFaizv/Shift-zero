captions = {"SPUN": "Halcyon keeps watch over First City.", "DAMNING": "Halcyon floats above the ruined factory and its rubble.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
