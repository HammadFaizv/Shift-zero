[gd_resource type="Resource" script_class="PanelData" format=3]
[ext_resource type="Script" path="res://scripts/data/panel_data.gd" id="panel"]
[ext_resource type="Script" path="res://scripts/data/poi_data.gd" id="poi"]
[ext_resource type="Texture2D" path="res://Assets/evidence_assets/stages/08_factory04.png" id="photo"]

[sub_resource type="Resource" id="Poi0"]
script = ExtResource("poi")
id = &"factory_4_0"
type = 0
description = "Hero"
desired = 0
position_uv = Vector2(0.3, 0.43)
radius_uv = 0.07
importance = 3.0
praise_lines = PackedStringArray("Panel {n}: Halcyon in the response. Steady hands in a hard moment.")

[sub_resource type="Resource" id="Poi1"]
script = ExtResource("poi")
id = &"factory_4_1"
type = 2
description = "Dead worker 1"
desired = 1
position_uv = Vector2(0.59, 0.84)
radius_uv = 0.12
importance = 6.0
comment_lines = PackedStringArray("Why is dead worker 1 visible in panel {n}?")
reply_lines = PackedStringArray("A tragedy. Halcyon did everything he could, so don't make it worse.")

[sub_resource type="Resource" id="Poi2"]
script = ExtResource("poi")
id = &"factory_4_2"
type = 2
description = "Dead worker 2"
desired = 1
position_uv = Vector2(0.87, 0.92)
radius_uv = 0.07
importance = 6.0
comment_lines = PackedStringArray("Why is dead worker 2 visible in panel {n}?")
reply_lines = PackedStringArray("Blame the factory owners, not the man who ran in to help.")

[resource]
script = ExtResource("panel")
id = &"factory_04"
title = "THE RESPONSE"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Halcyon responds as the emergency unfolds.", "DAMNING": "Dead workers lie on the factory floor beneath Halcyon.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Dead workers lie on the factory floor beneath Halcyon. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Halcyon responds as the emergency unfolds."
