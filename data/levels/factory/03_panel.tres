[resource]
script = ExtResource("panel")
id = &"factory_03"
title = "AT WORK"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Halcyon moves swiftly through the factory.", "DAMNING": "Two workers are caught in the destruction around Halcyon.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Two workers are caught in the destruction around Halcyon. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Halcyon moves swiftly through the factory."
