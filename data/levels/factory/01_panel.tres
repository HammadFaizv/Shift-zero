[gd_resource type="Resource" script_class="PanelData" format=3]
[ext_resource type="Script" path="res://scripts/data/panel_data.gd" id="panel"]
[ext_resource type="Script" path="res://scripts/data/poi_data.gd" id="poi"]
[ext_resource type="Texture2D" path="res://Assets/evidence_assets/stages/08_factory01.png" id="photo"]

[sub_resource type="Resource" id="Poi0"]
script = ExtResource("poi")
id = &"factory_1_0"
type = 0
description = "Hero"
desired = 0
position_uv = Vector2(0.84, 0.28)
radius_uv = 0.07
importance = 3.0
praise_lines = PackedStringArray("Panel {n}: Halcyon inspects the factory. Always one step ahead.")

[sub_resource type="Resource" id="Poi1"]
script = ExtResource("poi")
id = &"factory_1_1"
type = 5
description = "Factory"
desired = 0
position_uv = Vector2(0.33, 0.68)
radius_uv = 0.14
importance = 3.0
comment_lines = PackedStringArray("Is that the Reckon factory in panel {n}? Who signed off on its safety checks?")
reply_lines = PackedStringArray("Halcyon is the only one who actually inspected it.")

[resource]
script = ExtResource("panel")
id = &"factory_01"
title = "THE INSPECTION"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1")])
rule_order = PackedInt32Array(1, 0, 2)
captions = {"SPUN": "Halcyon arrives for a factory safety inspection.", "DAMNING": "Halcyon surveys the Reckon factory.", "MURKY": "The scene needs clearer lighting.", "TAMPERED": "This print is scorched. Prepare a fresh copy."}
balloons = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": ""}
sound_effects = {"SPUN": "", "DAMNING": "", "MURKY": "", "TAMPERED": "FZZT!"}
comments = {"SPUN": "Another day saved in panel {n}!", "DAMNING": "Halcyon surveys the Reckon factory. Look at panel {n}.", "MURKY": "Panel {n} is difficult to read."}
rationale = "Halcyon arrives for a factory safety inspection."
