[resource]
script = ExtResource("panel")
id = &"rescue_02_panel"
title = "THE RESCUE"
texture = ExtResource("photo")
pois = Array[ExtResource("poi")]([SubResource("Poi0"), SubResource("Poi1"), SubResource("Poi2")])
