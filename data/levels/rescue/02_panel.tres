captions = {
"DAMNING": "The rescue was a success. Mostly.",
"MURKY": "Halcyon carries someone out of the dark...",
"SPUN": "Halcyon saves a child from the flames!",
"TAMPERED": "Oops! This panel went up in smoke."
}
balloons = {
"DAMNING": "",
"MURKY": "",
"SPUN": "You're safe now, little one.",
"TAMPERED": ""
}
sound_effects = {
"DAMNING": "...",
"MURKY": "",
"SPUN": "SAVED!",
"TAMPERED": "FZZT!"
}
comments = {
"DAMNING": "Panel {n} has more going on than the caption says.",
"MURKY": "I can barely see the rescue in panel {n}.",
"SPUN": "A rescued child in panel {n}. I am sobbing. This is why we love him."
}
rationale = "One child saved is the story. The rest is smoke."
