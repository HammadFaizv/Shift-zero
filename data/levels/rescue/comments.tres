[gd_resource type="Resource" script_class="CommentTemplates" format=3]
[ext_resource type="Script" path="res://scripts/data/comment_templates.gd" id="script"]
[resource]
script = ExtResource("script")
usernames = PackedStringArray("city_mum", "halcyon_fan", "beacon_reader", "first_city_kid", "square_watch", "morning_reader")
fan_comments = PackedStringArray("We don’t deserve Halcyon!", "My son wants to be just like him!", "Another day saved by First City’s greatest hero.", "I feel safer knowing he’s out there.", "Best edition this week. Halcyon, the city is yours.", "I cut this page out for my fridge.", "Say what you like, First City is safer with him in it.", "My whole street is reading this together. Thank you, Halcyon!", "A hero in the flames. I'm still shaking.")
skeptic_comments = PackedStringArray("Can we get a clearer photograph?", "The caption and the photo don’t match.", "Is it just me, or is something missing from these photos?", "Why does the editor keep zooming in on certain panels?", "I would like to see the unedited prints.", "Why is a witness lying near the rubble?")
burned_comment = "Panel %d looks scorched. Is there a fresh copy?"
murky_group = "These photos need more light."
fan_reply = "He always keeps First City safe."
twist = ""
twist_reply = ""
post_caption = "RACES TO THE RESCUE! #CaptainHalcyon #FirstCity"
page_praise = "The Rescue is the best comic we have had. Halcyon runs into fire so we don't have to."
page_critic = "The prints do not match the caption. Check the fire again."
page_critic_reply = "He saved a child from a burning building. Show some decency."
