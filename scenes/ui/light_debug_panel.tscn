[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/light_debug_ui.gd" id="script"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.055, 0.067, 0.078, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.22, 0.25, 0.29, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[node name="LightDebugPanel" type="PanelContainer"]
mouse_filter = 2
theme_override_styles/panel = SubResource("PanelStyle")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.92, 0.84, 0.66, 1)
theme_override_font_sizes/font_size = 18
text = "LIGHT READINGS"

[node name="Thresholds" type="Label" parent="Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.65, 0.7, 0.77, 1)
theme_override_font_sizes/font_size = 13
text = "H1: hero     E2-E4: evidence
Hidden < 30%  /  Visible >= 55%"
